rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function idSeguro(id) {
      return id.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    function dataIso(valor) {
      return valor is string && valor.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$');
    }

    function dataIsoOuNula(valor) {
      return valor == null || dataIso(valor);
    }

    function texto(valor, maximo) {
      return valor is string && valor.size() >= 1 && valor.size() <= maximo;
    }

    function textoOuNulo(valor, maximo) {
      return valor == null || texto(valor, maximo);
    }

    function numero(valor) {
      return valor is number;
    }

    function controleValido(dados) {
      return dataIso(dados.createdAt)
        && dataIso(dados.updatedAt)
        && dataIsoOuNula(dados.deletedAt)
        && dados.servidorEm == request.time;
    }

    function alteracaoValida() {
      return request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt >= resource.data.updatedAt;
    }

    function desenhoValido(desenho) {
      return desenho is map
        && desenho.keys().hasOnly(['tracos', 'quadro'])
        && desenho.keys().hasAll(['tracos', 'quadro'])
        && desenho.tracos is list
        && desenho.tracos.size() >= 1
        && desenho.tracos.size() <= 300
        && desenho.quadro is map
        && desenho.quadro.keys().hasOnly(['width', 'height'])
        && desenho.quadro.keys().hasAll(['width', 'height'])
        && numero(desenho.quadro.width)
        && numero(desenho.quadro.height);
    }

    function perfilValido(dados) {
      return dados.keys().hasOnly(['email', 'nome', 'cpf', 'telefone', 'fotoSha256', 'createdAt', 'updatedAt', 'deletedAt', 'servidorEm'])
        && dados.keys().hasAll(['email', 'nome', 'cpf', 'telefone', 'fotoSha256', 'createdAt', 'updatedAt', 'deletedAt', 'servidorEm'])
        && texto(dados.email, 254)
        && textoOuNulo(dados.nome, 120)
        && (dados.cpf == null || (dados.cpf is string && dados.cpf.matches('^[0-9]{11}$')))
        && (dados.telefone == null || (dados.telefone is string && dados.telefone.matches('^[0-9]{10,11}$')))
        && (dados.fotoSha256 == null || (dados.fotoSha256 is string && dados.fotoSha256.matches('^[0-9a-f]{64}$')))
        && controleValido(dados);
    }

    function assinaturaValida(dados) {
      return dados.keys().hasOnly(['nome', 'desenho', 'createdAt', 'updatedAt', 'deletedAt', 'servidorEm'])
        && dados.keys().hasAll(['nome', 'desenho', 'createdAt', 'updatedAt', 'deletedAt', 'servidorEm'])
        && texto(dados.nome, 40)
        && desenhoValido(dados.desenho)
        && controleValido(dados);
    }

    function coordenadasValidas(coordenadas) {
      return coordenadas is map
        && coordenadas.keys().hasOnly(['latitude', 'longitude'])
        && coordenadas.keys().hasAll(['latitude', 'longitude'])
        && numero(coordenadas.latitude)
        && coordenadas.latitude >= -90 && coordenadas.latitude <= 90
        && numero(coordenadas.longitude)
        && coordenadas.longitude >= -180 && coordenadas.longitude <= 180;
    }

    function localValido(local) {
      return local is map
        && local.keys().hasOnly(['coordenadas', 'cidade'])
        && local.keys().hasAll(['coordenadas', 'cidade'])
        && coordenadasValidas(local.coordenadas)
        && textoOuNulo(local.cidade, 120);
    }

    function documentoValido(dados) {
      return dados.keys().hasOnly([
          'titulo', 'assinaturaUsada', 'tamanhoFoto', 'selo', 'local', 'assinadoEm', 'codigo', 'fotoSha256',
          'createdAt', 'updatedAt', 'deletedAt', 'servidorEm'
        ])
        && dados.keys().hasAll([
          'titulo', 'assinaturaUsada', 'tamanhoFoto', 'selo', 'local', 'assinadoEm', 'codigo', 'fotoSha256',
          'createdAt', 'updatedAt', 'deletedAt', 'servidorEm'
        ])
        && texto(dados.titulo, 60)
        && dados.assinaturaUsada is map
        && dados.assinaturaUsada.keys().hasOnly(['nome', 'desenho'])
        && dados.assinaturaUsada.keys().hasAll(['nome', 'desenho'])
        && texto(dados.assinaturaUsada.nome, 40)
        && desenhoValido(dados.assinaturaUsada.desenho)
        && dados.tamanhoFoto is map
        && dados.tamanhoFoto.keys().hasOnly(['width', 'height'])
        && dados.tamanhoFoto.keys().hasAll(['width', 'height'])
        && numero(dados.tamanhoFoto.width)
        && numero(dados.tamanhoFoto.height)
        && dados.selo is map
        && dados.selo.keys().hasOnly(['x', 'y', 'largura'])
        && dados.selo.keys().hasAll(['x', 'y', 'largura'])
        && numero(dados.selo.x)
        && numero(dados.selo.y)
        && numero(dados.selo.largura)
        && localValido(dados.local)
        && dataIso(dados.assinadoEm)
        && textoOuNulo(dados.codigo, 4000)
        && (dados.fotoSha256 == null || (dados.fotoSha256 is string && dados.fotoSha256.matches('^[0-9a-f]{64}$')))
        && controleValido(dados);
    }

    match /usuarios/{uid} {
      allow read: if dono(uid);
      allow create: if dono(uid) && perfilValido(request.resource.data);
      allow update: if dono(uid) && perfilValido(request.resource.data) && alteracaoValida();
      allow delete: if false;

      match /assinaturas/{id} {
        allow read: if dono(uid);
        allow create: if dono(uid) && idSeguro(id) && assinaturaValida(request.resource.data);
        allow update: if dono(uid) && idSeguro(id) && assinaturaValida(request.resource.data) && alteracaoValida();
        allow delete: if false;
      }

      match /documentos/{id} {
        allow read: if dono(uid);
        allow create: if dono(uid) && idSeguro(id) && documentoValido(request.resource.data);
        allow update: if dono(uid) && idSeguro(id) && documentoValido(request.resource.data) && alteracaoValida();
        allow delete: if false;
      }
    }
  }
}
