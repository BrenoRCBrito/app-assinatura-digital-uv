{
  "name": "assinaaqui",
  "version": "26.10.24",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "android:apk": "bash scripts/build-android.sh",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "api": "npm --prefix api start",
    "test:api": "npm --prefix api test",
    "api:up": "bash api/scripts/up.sh",
    "api:down": "bash api/scripts/down.sh",
    "api:logs": "bash api/scripts/logs.sh"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "expo": "~58.0.24",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-local-authentication": "~58.0.3",
    "expo-location": "~58.0.21",
    "expo-media-library": "~58.0.14",
    "expo-network": "~58.0.5",
    "expo-print": "~58.0.9",
    "expo-screen-orientation": "~58.0.4",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.16",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "firebase": "^13.2.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-toast-message": "^2.5.2",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "<rootDir>/node_modules/react-native-reanimated/jest/resolver.js",
    "setupFiles": [
      "./node_modules/react-native-gesture-handler/jestSetup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testTimeout": 15000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/regras-do-firestore/",
      "<rootDir>/api/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/api/"
    ]
  }
}
